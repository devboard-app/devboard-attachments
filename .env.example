JWT_SECRET=your_jwt_secret
INTERNAL_API_KEY=your_internal_api_key

DATABASE_URL=postgresql+asyncpg://attachments_user:your_attachments_password@devboard-db:5432/attachments_db


S3_ENDPOINT_URL=http://devboard-minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your_minio_root_user
S3_SECRET_KEY=your_minio_root_password
