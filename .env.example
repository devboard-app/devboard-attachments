JWT_SECRET=your_jwt_secret
INTERNAL_API_KEY=your_internal_api_key

# read by devboard-infra/setup.bat when it creates the attachments_user role
ATTACHMENTS_DB_PASSWORD=your_attachments_password

# async driver, used by the app
DATABASE_URL=postgresql+asyncpg://attachments_user:your_attachments_password@devboard-db:5432/attachments_db
# sync driver, used by alembic only
DATABASE_URL_SYNC=postgresql+psycopg2://attachments_user:your_attachments_password@devboard-db:5432/attachments_db


S3_ENDPOINT_URL=http://devboard-minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your_minio_root_user
S3_SECRET_KEY=your_minio_root_password
S3_BUCKET=devboard-attachments

MAX_FILE_SIZE_MB=5
PRESIGNED_URL_TTL_SECONDS=900

REDIS_URL=redis://devboard-redis:6379/0